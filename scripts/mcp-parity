#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx", "fastmcp"]
# ///
"""check the hosted MCP against the REST API it wraps.

The MCP is a thin wrapper, so every tool has a REST equivalent — which means
the two can silently disagree. They have, twice:

  - fastmcp.app serves the LAST GOOD build when a build fails, so the MCP can
    lag the repo with no error anywhere. Probe 1 catches that.
  - get_document re-implemented content extraction in python and drifted from
    the backend's extractor: "" from MCP, 5,326 chars from /document for the
    same URI. Probe 4 catches that.

Usage:
    ./scripts/mcp-parity
    ./scripts/mcp-parity --undiscoverable-did did:plc:xyz   # also check visibility parity
"""

from __future__ import annotations

import asyncio
import json
import sys

import httpx
from fastmcp import Client

MCP_URL = "https://pub-search-by-zzstoatzz.fastmcp.app/mcp"
REST = "https://leaflet-search-backend.fly.dev"

QUERIES = [("atproto", "keyword"), ("relay", "hybrid"), ("photography", "keyword"),
           ("zig programming", "semantic"), ("music", "hybrid")]


def rest_search(**params) -> list[dict]:
    params.setdefault("format", "v2")
    r = httpx.get(f"{REST}/search", params=params, timeout=40.0)
    r.raise_for_status()
    d = r.json()
    return d.get("results", []) if isinstance(d, dict) else d


def rows(res) -> list[dict]:
    d = res.data if hasattr(res, "data") else res
    if isinstance(d, dict):
        for k in ("result", "results"):
            if k in d:
                d = d[k]
                break
    if d is None:
        return []
    if not isinstance(d, list):
        d = [d]
    return [x if isinstance(x, dict) else json.loads(json.dumps(x, default=lambda o: o.__dict__)) for x in d]


def uris(rs) -> list[str]:
    return [x.get("uri") for x in rs if x.get("uri")]


async def main() -> int:
    did = None
    if "--undiscoverable-did" in sys.argv:
        did = sys.argv[sys.argv.index("--undiscoverable-did") + 1]

    fail: list[str] = []
    async with Client(MCP_URL) as client:
        tools = {t.name: t for t in await client.list_tools()}

        # 1. is the deployed build current?
        schema = getattr(tools["search"], "input_schema", None) or tools["search"].inputSchema
        if "include_undiscoverable" in schema.get("properties", {}):
            print("PASS  MCP build is current")
        else:
            fail.append("MCP build is STALE (search lacks include_undiscoverable)")
            print("FAIL  MCP build is STALE — fastmcp.app is serving an older build")

        # 2. same documents as REST
        print()
        for q, mode in QUERIES:
            limit = 10
            m = uris(rows(await client.call_tool("search", {"query": q, "mode": mode, "limit": limit})))
            r = uris(rest_search(q=q, mode=mode, limit=limit))
            overlap = len(set(m) & set(r))
            # Only keyword is deterministic. Semantic (and hybrid's semantic
            # arm) go through turbopuffer ANN, which does not repeat exactly —
            # REST disagrees with ITSELF at ~9/10 on the same query, so
            # demanding equality would test the vector index, not parity.
            if mode == "keyword":
                ok, note = set(m) == set(r), "identical" if m == r else "same set"
            else:
                ok = overlap >= 0.7 * max(len(m), len(r), 1)
                note = f"{overlap}/{max(len(m), len(r))} overlap (ANN variance)"
            if not ok:
                fail.append(f"{mode}/{q}: MCP and REST disagree")
            print(f"{'PASS' if ok else 'FAIL'}  {mode:8} {q!r:22} mcp={len(m):2} rest={len(r):2}  {note}")
            if len(m) < min(limit, len(r)):
                fail.append(f"{mode}/{q}: MCP returned {len(m)} of {len(r)} available")

        # 3. every tool returns something usable
        print()
        seed = rows(await client.call_tool("search", {"query": "atproto", "limit": 5}))
        seed_uri = seed[0]["uri"]
        for name, args in [
            ("find_similar", {"uri": seed_uri, "limit": 5}),
            ("get_tags", {"limit": 5}),
            ("get_popular", {"limit": 5}),
            ("get_stats", {}),
            ("discover_focal_post", {"window": "week", "sort": "trending"}),
            ("recommended_by_top_authors", {"top_authors": 3, "window": "month"}),
        ]:
            try:
                out = rows(await client.call_tool(name, args))
                if not out:
                    fail.append(f"{name} returned nothing")
                print(f"{'PASS' if out else 'FAIL'}  {name:28} -> {len(out)} row(s)")
            except Exception as exc:  # noqa: BLE001
                fail.append(f"{name} raised {exc!r}")
                print(f"FAIL  {name:28} -> {exc}")

        # 4. get_document must match /document, not a local re-extraction
        print()
        d = rows(await client.call_tool("get_document", {"uri": seed_uri}))[0]
        rest_doc = httpx.get(f"{REST}/document", params={"uri": seed_uri}, timeout=40.0).json()
        rest_content = (rest_doc.get("documents") or [{}])[0].get("content", "")
        mcp_content = d.get("content", "") or ""
        if mcp_content == rest_content and mcp_content:
            print(f"PASS  get_document matches /document ({len(mcp_content)} chars)")
        else:
            fail.append(f"get_document differs from /document ({len(mcp_content)} vs {len(rest_content)} chars)")
            print(f"FAIL  get_document {len(mcp_content)} chars vs /document {len(rest_content)}")

        # 5. visibility parity
        if did:
            print()
            m_def = uris(rows(await client.call_tool("search", {"query": "", "author": did, "limit": 40})))
            m_opt = uris(rows(await client.call_tool(
                "search", {"query": "", "author": did, "limit": 40, "include_undiscoverable": True})))
            r_def = uris(rest_search(author=did, limit=40))
            leaked = set(m_def) - set(r_def)
            print(f"      opted-out author: mcp {len(m_def)}/{len(m_opt)}  rest {len(r_def)}")
            if leaked:
                fail.append("MCP default exposes documents REST hides")
                print("FAIL  MCP default leaks vs REST")
            elif len(m_opt) <= len(m_def):
                fail.append("include_undiscoverable had no effect through MCP")
                print("FAIL  include_undiscoverable has no effect")
            else:
                print("PASS  visibility consistent, opt-in works")

    print("\n" + "=" * 60)
    if fail:
        print(f"{len(fail)} FAILURE(S):")
        for f in fail:
            print(f"  - {f}")
        return 1
    print("MCP and REST are consistent and complete.")
    return 0


if __name__ == "__main__":
    raise SystemExit(asyncio.run(main()))
